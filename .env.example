# APP
# URL pública del sitio: metadata, Open Graph y sitemap.
SITE_URL=http://localhost:3000

# API
# Backend visto desde el SERVIDOR de Next (Server Components y el proxy
# /api/v1 que usa el navegador). Es variable de EJECUCIÓN: el build no la
# necesita. En Dokploy puede ser la URL interna del servicio del backend.
API_URL=http://localhost:4000/api/v1

# Origen público de las fotos (= APP_BASE_URL del backend). Con él se autoriza
# a next/image a optimizar las fotos de /uploads.
#   producción: https://ranchoporvenirapi.ecohotelsamawe.com
MEDIA_URL=http://localhost:4000
